PORT=3000

# SQL Server connection — requires SQL Server Authentication (Mixed Mode)
# enabled on your instance, plus a SQL login (not just Windows auth).
# DB_HOST: use "localhost" for a default instance, or "localhost\SQLEXPRESS"
# style if you installed a named instance (common with SQL Server Express).
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_sql_server_password
DB_NAME=simple_erp

SESSION_SECRET=change_this_to_a_random_long_string
