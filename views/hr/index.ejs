<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Employees</h2>
  <div>
    <form action="/employees/run-payroll" method="POST" class="d-inline" onsubmit="return confirm('Run payroll for all active employees?')">
      <button class="btn btn-outline-success">Run Payroll</button>
    </form>
    <a href="/employees/new" class="btn btn-primary">+ Add Employee</a>
  </div>
</div>

<div class="card shadow-sm"><div class="card-body p-0">
  <table class="table mb-0">
    <thead><tr><th>Name</th><th>Department</th><th>Position</th><th>Salary</th><th>Hire Date</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% if (employees.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-3">No employees yet.</td></tr><% } %>
    <% employees.forEach(e => { %>
      <tr>
        <td><%= e.full_name %></td>
        <td><%= e.department %></td>
        <td><%= e.position %></td>
        <td class="mono">$<%= Number(e.salary).toFixed(2) %></td>
        <td><%= e.hire_date ? e.hire_date.toISOString().split('T')[0] : '' %></td>
        <td><span class="badge bg-<%= e.status === 'active' ? 'success' : 'secondary' %>"><%= e.status %></span></td>
        <td class="d-flex gap-1">
          <a href="/employees/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
          <form action="/employees/<%= e.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Remove employee?')">
            <button class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div></div>
<%- include('../partials/footer') %>
