<%- include('../partials/header') %>
<h2 class="mb-3">Suppliers</h2>

<div class="card shadow-sm mb-4"><div class="card-body">
  <h5>Add Supplier</h5>
  <form action="/suppliers" method="POST" class="row g-2">
    <div class="col-md-3"><input class="form-control" name="name" placeholder="Supplier Name" required></div>
    <div class="col-md-3"><input class="form-control" name="contact_person" placeholder="Contact Person"></div>
    <div class="col-md-2"><input class="form-control" name="email" placeholder="Email"></div>
    <div class="col-md-2"><input class="form-control" name="phone" placeholder="Phone"></div>
    <div class="col-md-2"><input class="form-control" name="address" placeholder="Address"></div>
    <div class="col-12"><button class="btn btn-primary mt-2">Add Supplier</button></div>
  </form>
</div></div>

<div class="card shadow-sm"><div class="card-body p-0">
  <table class="table mb-0">
    <thead><tr><th>Name</th><th>Contact</th><th>Email</th><th>Phone</th><th>Address</th><th></th></tr></thead>
    <tbody>
    <% if (suppliers.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-3">No suppliers yet.</td></tr><% } %>
    <% suppliers.forEach(s => { %>
      <tr>
        <td><%= s.name %></td><td><%= s.contact_person %></td><td><%= s.email %></td>
        <td><%= s.phone %></td><td><%= s.address %></td>
        <td><form action="/suppliers/<%= s.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete supplier?')">
          <button class="btn btn-sm btn-outline-danger">Delete</button></form></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div></div>
<%- include('../partials/footer') %>
