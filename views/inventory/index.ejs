<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Inventory</h2>
  <a href="/inventory/new" class="btn btn-primary">+ Add Product</a>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table mb-0">
      <thead>
        <tr><th>SKU</th><th>Name</th><th>Category</th><th>Unit Price</th><th>Qty</th><th>Reorder At</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">No products yet. Add your first one.</td></tr>
        <% } %>
        <% products.forEach(p => { %>
          <tr class="<%= p.quantity <= p.reorder_level ? 'table-danger' : '' %>">
            <td class="mono"><%= p.sku %></td>
            <td><%= p.name %></td>
            <td><%= p.category %></td>
            <td class="mono">$<%= Number(p.unit_price).toFixed(2) %></td>
            <td class="mono fw-bold"><%= p.quantity %></td>
            <td class="mono"><%= p.reorder_level %></td>
            <td class="d-flex gap-1">
              <a href="/inventory/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
              <form action="/inventory/<%= p.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this product?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#adj-<%= p.id %>">Adjust</button>
            </td>
          </tr>
          <tr class="collapse" id="adj-<%= p.id %>">
            <td colspan="7">
              <form action="/inventory/<%= p.id %>/adjust" method="POST" class="d-flex gap-2 align-items-center py-2">
                <input type="number" name="change_qty" class="form-control form-control-sm" style="width:100px" placeholder="+/- qty" required>
                <input type="text" name="reason" class="form-control form-control-sm" style="width:220px" placeholder="Reason (e.g. damaged, correction)">
                <button class="btn btn-sm btn-primary">Apply</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
