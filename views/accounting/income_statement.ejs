<%- include('../partials/header') %>
<h2 class="mb-3">Income Statement</h2>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header">Revenue</div>
      <table class="table mb-0">
        <tbody>
        <% revenue.forEach(r => { %>
          <tr><td><%= r.name %></td><td class="text-end">$<%= Number(r.balance).toFixed(2) %></td></tr>
        <% }) %>
        </tbody>
        <tfoot><tr class="fw-bold"><td>Total Revenue</td><td class="text-end">$<%= totalRevenue.toFixed(2) %></td></tr></tfoot>
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header">Expenses</div>
      <table class="table mb-0">
        <tbody>
        <% expenses.forEach(e => { %>
          <tr><td><%= e.name %></td><td class="text-end">$<%= Number(e.balance).toFixed(2) %></td></tr>
        <% }) %>
        </tbody>
        <tfoot><tr class="fw-bold"><td>Total Expenses</td><td class="text-end">$<%= totalExpense.toFixed(2) %></td></tr></tfoot>
      </table>
    </div>
  </div>
</div>

<div class="card shadow-sm mt-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <h4 class="mb-0">Net Income</h4>
    <h4 class="mb-0 <%= netIncome >= 0 ? 'text-success' : 'text-danger' %>">$<%= netIncome.toFixed(2) %></h4>
  </div>
</div>
<%- include('../partials/footer') %>
