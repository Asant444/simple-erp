<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>General Ledger</h2>
  <a href="/ledger/new" class="btn btn-primary">+ New Journal Entry</a>
</div>
<div class="card shadow-sm"><div class="card-body p-0">
  <table class="table mb-0">
    <thead><tr><th>Date</th><th>Description</th><th>Debit Account</th><th>Credit Account</th><th>Amount</th><th>Reference</th></tr></thead>
    <tbody>
    <% if (transactions.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-3">No transactions yet.</td></tr><% } %>
    <% transactions.forEach(t => { %>
      <tr>
        <td><%= t.txn_date.toISOString().split('T')[0] %></td>
        <td><%= t.description %></td>
        <td><%= t.debit_account %></td>
        <td><%= t.credit_account %></td>
        <td class="mono">$<%= Number(t.amount).toFixed(2) %></td>
        <td><span class="badge bg-secondary"><%= t.reference %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div></div>
<%- include('../partials/footer') %>
