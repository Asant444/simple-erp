<%- include('../partials/header') %>
<h2 class="mb-3">New Journal Entry</h2>
<div class="card shadow-sm"><div class="card-body">
<form action="/ledger" method="POST">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Date</label>
      <input type="date" name="txn_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Amount</label>
      <input type="number" step="0.01" name="amount" class="form-control" required>
    </div>
    <div class="col-12">
      <label class="form-label">Description</label>
      <input type="text" name="description" class="form-control" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Debit Account</label>
      <select name="debit_account_id" class="form-select" required>
        <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.name %> (<%= a.type %>)</option><% }) %>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label">Credit Account</label>
      <select name="credit_account_id" class="form-select" required>
        <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.name %> (<%= a.type %>)</option><% }) %>
      </select>
    </div>
  </div>
  <button type="submit" class="btn btn-primary mt-4">Record Entry</button>
  <a href="/ledger" class="btn btn-outline-secondary mt-4">Cancel</a>
</form>
</div></div>
<%- include('../partials/footer') %>
